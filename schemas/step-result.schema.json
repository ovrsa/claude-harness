{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude.local/schemas/step-result.schema.json",
  "title": "Claude Harness Workflow Step Result",
  "type": "object",
  "required": ["condition", "status"],
  "additionalProperties": true,
  "properties": {
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permission_requests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
