{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-harness.local/schemas/experience/outcome.schema.json",
  "title": "Experience Outcome",
  "type": "object",
  "required": ["schemaVersion", "outcome", "reason", "source", "finalizedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "outcome": { "enum": ["accepted", "corrected", "failed", "abandoned", "unknown"] },
    "reason": { "type": "string" },
    "source": { "type": "string" },
    "finalizedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
