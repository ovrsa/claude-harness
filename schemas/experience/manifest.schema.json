{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-harness.local/schemas/experience/manifest.schema.json",
  "title": "Experience Run Manifest",
  "type": "object",
  "required": ["schemaVersion", "runId", "createdAt", "runtime", "repository", "grill", "finalized"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "runtime": { "type": "string" },
    "repository": { "type": "object" },
    "harnessFingerprint": { "type": ["string", "null"] },
    "grill": { "type": "object" },
    "finalized": { "type": "boolean" },
    "finalizedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
