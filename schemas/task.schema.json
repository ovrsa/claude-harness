{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude.local/schemas/task.schema.json",
  "title": "Claude Harness Task",
  "type": "object",
  "required": ["task_id", "title", "status", "created_at", "updated_at"],
  "additionalProperties": true,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["pending", "running", "blocked", "done"]
    },
    "task_dir": {
      "type": "string"
    },
    "current_run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
