{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude.local/schemas/run.schema.json",
  "title": "Claude Harness Run",
  "type": "object",
  "required": ["run_id", "task_id", "status", "started_at"],
  "additionalProperties": true,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["running", "blocked", "done"]
    },
    "repo_root": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
