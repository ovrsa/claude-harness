{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude.local/schemas/lifecycle-workflow.schema.json",
  "title": "Claude Harness Lifecycle Workflow",
  "type": "object",
  "required": ["name", "initial_step", "max_steps", "steps"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "initial_step": {
      "type": "string",
      "minLength": 1
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mode", "rules"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": ["readonly", "edit", "full"]
          },
          "requires_approval": {
            "type": "boolean"
          },
          "facets": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            }
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "provider_options": {
            "type": "object"
          },
          "required_permission_mode": {
            "enum": ["readonly", "edit", "full"]
          },
          "quality_gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output_contracts": {
            "type": "object",
            "properties": {
              "report": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "format"],
                  "additionalProperties": true,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "format": {
                      "type": "string",
                      "minLength": 1
                    },
                    "order": {
                      "type": "string"
                    },
                    "use_judge": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "parallel": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": ["name", "mode", "rules"],
                  "additionalProperties": true
                }
              ]
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["condition", "next"],
              "additionalProperties": true,
              "properties": {
                "condition": {
                  "type": "string",
                  "minLength": 1
                },
                "next": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
