{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/experience-session-start.js\""
          }
        ],
        "description": "Start a sanitized JSON Experience run"
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/experience-user-prompt.js\"",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "Record only a classified feedback signal, never the raw prompt"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/experience-pre-tool.js\"",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "Append a bounded, sanitized pre-tool Experience event"
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/permission-request.js\""
          }
        ],
        "description": "Personal harness boundary for permission prompts: deny destructive bash and auto-allow narrow read-only inspection commands"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/experience-post-tool.js\"",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "Append a bounded, sanitized post-tool Experience event"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/experience-stop.js\"",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "Record response completion without gating the session"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/experience-session-end.js\""
          }
        ],
        "description": "Finalize the JSON Experience run with an honest structured outcome"
      }
    ]
  }
}
