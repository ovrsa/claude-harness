{
  "name": "claude-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Private Grill-based harness shared by Claude Code and Codex",
  "keywords": [
    "claude-code",
    "codex",
    "agent-harness",
    "grilling",
    "jsonl"
  ],
  "author": "ovrsa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovrsa/claude-harness.git"
  },
  "files": [
    "commands/",
    "contexts/",
    "hooks/",
    "mcp-configs/",
    "rules/",
    "schemas/",
    "scripts/ci/",
    "scripts/hooks/",
    "scripts/lib/",
    "scripts/claw.js",
    "scripts/experience-status.js",
    "scripts/resolve-managed-skill.js",
    "scripts/setup-package-manager.js",
    "scripts/skill-create-output.js",
    "CLAUDE.md",
    "AGENTS.md",
    "CONTEXT.md",
    "settings.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:markdown": "markdownlint '**/*.md' --ignore node_modules --ignore plugins --ignore .quarantine --ignore archive --ignore .scratch",
    "lint:unused": "knip --config knip.json --no-exit-code --reporter compact",
    "lint:architecture": "depcruise --config .dependency-cruiser.js --include-only '^(hooks|scripts)' hooks scripts",
    "lint:repo": "npm run lint && npm run lint:unused && npm run lint:architecture",
    "claw": "node scripts/claw.js",
    "experience:status": "node scripts/experience-status.js",
    "test:validators": "node scripts/ci/validate-runtime-surface.js && node scripts/ci/validate-hooks.js && node scripts/ci/validate-commands.js && node scripts/ci/validate-rules.js && node scripts/ci/validate-no-personal-paths.js && node scripts/ci/audit-harness-contract.js",
    "test:smoke": "node scripts/ci/smoke-grill-harness.js",
    "test:core": "npm run test:validators && npm run test:smoke && node tests/run-all.js --suite core",
    "test:hooks": "node tests/run-all.js --suite hooks",
    "test:regression": "node tests/run-all.js --suite regression",
    "test:full": "npm run test:validators && npm run test:smoke && node tests/run-all.js --suite full",
    "test:optional": "node scripts/ci/validate-agents.js && node scripts/ci/validate-skills.js",
    "test": "npm run test:core"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "knip": "^6.4.1",
    "markdownlint-cli": "^0.48.0"
  },
  "engines": {
    "node": ">=18"
  }
}
