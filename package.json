{
  "name": "ecc-universal",
  "version": "1.8.0",
  "description": "Complete collection of battle-tested Claude Code configs — agents, skills, hooks, commands, and rules evolved over 10+ months of intensive daily use by an Anthropic hackathon winner",
  "keywords": [
    "claude-code",
    "ai",
    "agents",
    "skills",
    "hooks",
    "mcp",
    "rules",
    "claude",
    "anthropic",
    "tdd",
    "code-review",
    "security",
    "automation",
    "best-practices",
    "cursor",
    "cursor-ide",
    "opencode",
    "codex",
    "presentations",
    "slides"
  ],
  "author": {
    "name": "Affaan Mustafa",
    "url": "https://x.com/affaanmustafa"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affaan-m/everything-claude-code.git"
  },
  "homepage": "https://github.com/affaan-m/everything-claude-code#readme",
  "bugs": {
    "url": "https://github.com/affaan-m/everything-claude-code/issues"
  },
  "files": [
    "commands/",
    "contexts/",
    "hooks/",
    "mcp-configs/",
    "rules/",
    "schemas/",
    "scripts/ci/",
    "scripts/hooks/",
    "scripts/lib/",
    "scripts/claw.js",
    "scripts/trace-status.js",
    "scripts/setup-package-manager.js",
    "scripts/skill-create-output.js",
    "skills/continuous-learning-v2/hooks/observe.sh",
    "skills/continuous-learning-v2/scripts/detect-project.sh",
    "install.sh",
    "llms.txt",
    "settings.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ecc-install": "install.sh"
  },
  "scripts": {
    "postinstall": "echo '\\n  ecc-universal installed!\\n  Run: npx ecc-install typescript\\n  Docs: https://github.com/affaan-m/everything-claude-code\\n'",
    "lint": "eslint .",
    "lint:markdown": "markdownlint '**/*.md' --ignore node_modules",
    "lint:unused": "knip --config knip.json --no-exit-code --reporter compact",
    "lint:architecture": "depcruise --config .dependency-cruiser.js --include-only '^(hooks|scripts)' hooks scripts",
    "lint:repo": "npm run lint && npm run lint:unused && npm run lint:architecture",
    "claw": "node scripts/claw.js",
    "pipeline:runner": "node scripts/pipeline-runner.js",
    "test:core": "node scripts/ci/validate-runtime-surface.js && node scripts/ci/validate-hooks.js && node scripts/ci/validate-commands.js && node scripts/ci/validate-rules.js && node scripts/ci/validate-artifact-templates.js && node scripts/ci/validate-no-personal-paths.js && node scripts/ci/audit-harness-contract.js && node scripts/ci/smoke-harness-lifecycle.js && node tests/run-all.js",
    "test:optional": "node scripts/ci/validate-agents.js && node scripts/ci/validate-skills.js",
    "test": "npm run test:core"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "knip": "^6.4.1",
    "markdownlint-cli": "^0.48.0"
  },
  "engines": {
    "node": ">=18"
  }
}
